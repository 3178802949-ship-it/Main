+                      + .13 * (state['p_eff']['burst'] - 120))
+    arrival = _arrival(card, state, wing, estimated_pace, ball, incoming_quality, 3.)
+    grades = arrival['grades']
+    position = (rng.choices([grade for grade, _, _ in grades], weights=[p for _, p, _ in grades])[0]
