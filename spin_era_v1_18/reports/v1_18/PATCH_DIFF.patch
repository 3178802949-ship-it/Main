+    def narrate_training(self, event_id, *, seed=None):
+        import narrative_v1_18 as narrative
+        receipt = self.data['events'][event_id]
+        if receipt.get('type') != 'training_phase':
+            raise ValueError('a settled training phase receipt is required')
+        links = [link for link in self.data['audit_chain']
+                 if link['kind'] == 'event' and link['id'] == event_id]
+        if len(links) != 1 or links[0]['payload_sha256'] != _hash(receipt):
+            raise ValueError('TRAINING_RECEIPT_AUDIT_MISMATCH')
+        return narrative.render_training(receipt,
+            seed=self.data['seed'] if seed is None else seed,
+            expected_sha256=links[0]['payload_sha256'])
