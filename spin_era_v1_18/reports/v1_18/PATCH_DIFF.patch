+    values = [.60 * core.gg(card, state, w) + .40 * card['children'][w][metric] for w in ('fh', 'bh')]
+    return rng.choices(('fh', 'bh'), weights=[math.exp(core.clamp((v - 120) / 22, -4, 3)) for v in values])[0]
+
